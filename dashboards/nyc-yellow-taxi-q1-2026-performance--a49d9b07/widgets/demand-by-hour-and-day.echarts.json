          "day_name",
          "pickup_hour",
          "avg_trips"
        ]
      }
    }
  ],
  "tooltip": {
    "trigger": "item"
  },
  "visualMap": {
    "max": 10500,
    "min": 0,
    "left": "center",
    "text": [
      "More trips per hour",
      "Fewer"
