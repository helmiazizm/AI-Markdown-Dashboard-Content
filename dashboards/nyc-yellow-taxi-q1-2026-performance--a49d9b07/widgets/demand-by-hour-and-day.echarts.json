{
  "grid": {
    "top": 16,
    "left": 8,
    "right": 20,
    "bottom": 56,
    "containLabel": true
  },
  "xAxis": {
    "name": "Pickup hour (0-23, local)",
    "type": "category",
    "nameGap": 30,
    "splitArea": {
      "show": true
    },
    "nameLocation": "middle"
  },
  "yAxis": {
    "type": "category",
    "splitArea": {
      "show": true
    }
  },
  "series": [
    {
      "type": "heatmap",
      "encode": {
        "x": "pickup_hour",
