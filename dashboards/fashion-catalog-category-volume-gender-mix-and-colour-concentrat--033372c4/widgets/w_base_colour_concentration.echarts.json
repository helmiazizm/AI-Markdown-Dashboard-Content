{
  "grid": {
    "left": "3%",
    "right": "4%",
    "bottom": "12%",
    "containLabel": true
  },
  "xAxis": {
    "type": "category",
    "axisLabel": {
      "rotate": 45
    }
  },
  "yAxis": [
    {
      "name": "Products",
      "type": "value"
    },
    {
      "max": 100,
      "name": "Cumulative %",
      "type": "value",
      "axisLabel": {
        "formatter": "{value}%"
      }
    }
  ],
  "legend": {
    "top": 0
  },
  "series": [
    {
      "name": "catalog_rows",
      "type": "bar",
      "encode": {
        "x": "base_colour",
        "y": "catalog_rows"
      },
      "itemStyle": {
        "borderRadius": [
          4,
          4,
          0,
          0
        ]
      },
      "barMaxWidth": 30
    },
    {
      "name": "cumulative_pct",
      "type": "line",
      "encode": {
        "x": "base_colour",
        "y": "cumulative_pct"
      },
      "smooth": true,
      "symbolSize": 7,
      "yAxisIndex": 1
    }
  ],
  "tooltip": {
    "trigger": "axis",
    "axisPointer": {
      "type": "shadow"
    }
  }
}
